{% extends 'base.html.twig' %}

{% block title %}Servicios - DS Classics{% endblock %}

{% block body %}
    <div class="container-fluid py-5">
        <div class="container">
            <div class="border-start border-5 border-primary ps-5 mb-5" style="max-width: 600px;">
                <h6 class="text-primary text-uppercase">Servicios</h6>
                <h1 class="display-5 text-uppercase mb-0">Cuidamos de tu Colección</h1>
            </div>
            <div class="row g-5">
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-house display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Compra de Juegos</h5>
                            <p>Tasamos tus juegos antiguos al mejor precio del mercado. Pago en efectivo o crédito en tienda.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-food display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Limpieza de Contactos</h5>
                            <p>Eliminamos la suciedad y oxidación de los pines de tus cartuchos para que carguen a la primera.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-grooming display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Cambio de Carcasas</h5>
                            <p>Reemplazamos carcasas rotas o amarillentas por nuevas ediciones limitadas o colores originales.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-cat display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Reparación de Pantallas</h5>
                            <p>Sustitución de pantallas táctiles rayadas, píxeles muertos o pantallas superiores en blanco.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-dog display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Verificación de Autenticidad</h5>
                            <p>¿No sabes si tu juego es original? Nuestros expertos analizan la placa y carcasa para confirmarlo.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="service-item bg-light d-flex p-4">
                        <i class="flaticon-vaccine display-1 text-primary me-4"></i>
                        <div>
                            <h5 class="text-uppercase mb-3">Reemplazo de Baterías</h5>
                            <p>Cambiamos las baterías internas de los cartuchos para que no pierdas tus partidas guardadas nunca más.</p>
                            <a class="text-primary text-uppercase" href="">Leer Más<i class="bi bi-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}