{% extends 'base.html.twig' %}

{% block title %}Tu Inventario - DS Classics{% endblock %}

{% block body %}
    <div class="container-fluid py-5 bg-dark text-light" style="min-height: 80vh;">
        <div class="container">
            <div class="border-start border-5 border-emerald ps-4 mb-5">
                <h1 class="display-4 text-uppercase fw-bold text-white">Tu Inventario</h1>
                <p class="text-emerald fw-bold text-uppercase">Gestiona tus adquisiciones antes de la partida</p>
            </div>

            {% if items is empty %}
                <div class="text-center py-5 border border-secondary rounded">
                    <i class="bi bi-cart-x display-1 text-secondary mb-4"></i>
                    <h3 class="text-secondary">Tu inventario está vacío</h3>
                    <a href="{{ path('game-shop') }}" class="btn btn-emerald text-dark fw-bold mt-3 px-4">VOLVER AL CATÁLOGO</a>
                </div>
            {% else %}
                <div class="table-responsive">
                    <table class="table table-dark table-hover align-middle border-emerald">
                        <thead class="text-emerald text-uppercase">
                        <tr>
                            <th scope="col">Imagen</th>
                            <th scope="col">Producto</th>
                            <th scope="col">Precio Unitario</th>
                            <th scope="col" style="width: 150px;">Cantidad</th>
                            <th scope="col">Subtotal</th>
                            <th scope="col" class="text-center">Acciones</th>
                        </tr>
                        </thead>
                        <tbody class="border-top-0">
                        {% for item in items %}
                            <tr>
                                <td>
                                    <img src="{{ asset('img/products/' ~ item.photo) }}" class="rounded border border-emerald p-1" style="width: 70px; height: 70px; object-fit: cover;">
                                </td>
                                <td class="text-white fw-bold">{{ item.name }}</td>
                                <td>{{ item.price|number_format(2, ',', '.') }} €</td>
                                <td>
                                    <div class="input-group input-group-sm border border-emerald rounded">
                                        <a href="{{ path('cart_remove', {id: item.id}) }}" class="btn btn-outline-emerald border-0">-</a>
                                        <input type="text" class="form-control bg-dark text-white border-0 text-center" value="{{ item.quantity }}" readonly>
                                        <a href="{{ path('cart_add_one', {id: item.id}) }}" class="btn btn-outline-emerald border-0">+</a>
                                    </div>
                                </td>
                                <td class="text-emerald fw-bold">
                                    {{ (item.price * item.quantity)|number_format(2, ',', '.') }} €
                                </td>
                                <td class="text-center">
                                    <a href="{{ path('cart_delete', {id: item.id}) }}" class="btn btn-sm btn-outline-danger shadow-sm">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>

                <div class="row justify-content-between mt-5">
                    <div class="col-md-4">
                        <a href="{{ path('cart_clear') }}" class="btn btn-outline-danger fw-bold px-4 py-2">
                            VACIAR CARRITO
                        </a>
                        <a href="{{ path('indice') }}" class="btn btn-emerald text-dark fw-bold px-4 py-2">
                            <i class="bi bi-plus-lg me-2"></i>AÑADIR MÁS PRODUCTOS
                        </a>
                    </div>
                    <div class="col-md-5 col-lg-4">
                        <div class="p-4 rounded border border-emerald shadow-emerald" style="background-color: #1a1a1a;">
                            <h4 class="text-white text-uppercase mb-4">Resumen de Compra</h4>
                            <div class="d-flex justify-content-between mb-3">
                                <span>Artículos distintos:</span>
                                <span class="text-emerald">{{ items|length }}</span>
                            </div>
                            <hr class="border-secondary">
                            <div class="d-flex justify-content-between align-items-center mt-3">
                                <span class="h4 text-white mb-0">TOTAL:</span>
                                <span class="h3 text-emerald fw-bold mb-0">{{ totalCart|number_format(2, ',', '.') }} €</span>
                            </div>
                            <button class="btn btn-emerald text-dark fw-bold w-100 mt-4 py-3 shadow">FINALIZAR PEDIDO</button>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}