{# templates/partials/product/_productItem.html.twig #}
<div class="pb-5">
    <div class="product-item position-relative bg-light d-flex flex-column text-center">
        <img class="img-fluid mb-4" src="{{ asset('img/products/' ~ product.photo) }}" alt="{{ product.name }}">
        <h6 class="text-uppercase text-dark">{{ product.name }}</h6>
        <h5 class="text-emerald mb-0">{{ product.price|number_format(2, ',', '.') }} €</h5>

        <div class="btn-action d-flex justify-content-center">
            <a class="btn btn-emerald add-to-cart" data-id="{{ product.id }}">
                <i class="bi bi-cart text-dark"></i>
            </a>
            <a class="btn btn-emerald py-2 px-3 open-info-product" data-id="{{ product.id }}">
                <i class="bi bi-eye text-dark"></i>
            </a>
        </div>
    </div>
</div>