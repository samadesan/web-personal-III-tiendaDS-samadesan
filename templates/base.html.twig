<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <title>{% block title %}DS CLASSICS{% endblock %}</title>
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta content="Juegos DS, Nintendo DS, Retro, Historia" name="keywords">
    <meta content="Conoce la historia detrás de DS Classics" name="description">

    <link rel="icon" type="image/png" href="{{ asset('img/tiendaDS-logo.jpeg') }}">

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins&family=Roboto:wght@700&display=swap" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.4.1/font/bootstrap-icons.css" rel="stylesheet">
    <link href="{{ asset('lib/flaticon/font/flaticon.css') }}" rel="stylesheet">
    <link href="{{ asset('lib/owlcarousel/assets/owl.carousel.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css/bootstrap.min.css') }}" rel="stylesheet">
    <link href="{{ asset('css/style.css') }}" rel="stylesheet">

    {% block stylesheets %}{% endblock %}

    {# Script rápido para evitar el flash blanco antes de cargar el CSS #}
    <script src="{{ asset('js/no-flash') }}"></script>
</head>

<body>
<div class="container-fluid border-bottom d-none d-lg-block">
    <div class="row gx-0">
        <div class="col-lg-4 text-center py-2">
            <div class="d-inline-flex align-items-center">
                <i class="bi bi-geo-alt fs-1 text-primary me-3"></i>
                <div class="text-start">
                    <h6 class="text-uppercase mb-1">Nuestra Tienda</h6>
                    <span>Calle Videojuegos 123, Madrid, ES</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-center border-start border-end py-2">
            <div class="d-inline-flex align-items-center">
                <i class="bi bi-envelope-open fs-1 text-primary me-3"></i>
                <div class="text-start">
                    <h6 class="text-uppercase mb-1">Escríbenos</h6>
                    <span>ventas@dsclassics.com</span>
                </div>
            </div>
        </div>
        <div class="col-lg-4 text-center py-2">
            <div class="d-inline-flex align-items-center">
                <i class="bi bi-phone-vibrate fs-1 text-primary me-3"></i>
                <div class="text-start">
                    <h6 class="text-uppercase mb-1">Llámanos</h6>
                    <span>+34 123 456 789</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% set route = app.request.attributes.get('_route') %}

<nav class="navbar navbar-expand-lg bg-white navbar-light shadow-sm py-3 py-lg-0 px-3 px-lg-0 mb-5">
    <a href="{{ path('indice') }}" class="navbar-brand ms-lg-5">
        <h1 class="m-0 text-uppercase text-dark"><img src="{{ asset('img/tiendaDS-logo.jpeg') }}" alt="Imagen Logo" style="width: 104px;">DS Classics</h1>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCollapse">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarCollapse">
        <div class="navbar-nav ms-auto py-0">
            <a href="{{ path('indice') }}" class="nav-item nav-link {{ route == 'indice' ? 'active' : '' }}">Inicio</a>
            <a href="{{ path('about') }}" class="nav-item nav-link {{ route == 'about' ? 'active' : '' }}">Nosotros</a>
            <a href="{{ path('servicio') }}" class="nav-item nav-link {{ route == 'servicio' ? 'active' : '' }}">Servicios</a>
            <a href="{{ path('game-shop') }}" class="nav-item nav-link {{ route == 'game-shop' ? 'active' : '' }}">Juegos</a>

            <div class="nav-item dropdown">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">Secciones</a>
                <div class="dropdown-menu m-0">
                    <a href="{{ path('plan-socios') }}" class="dropdown-item">Planes de Socio</a>
                    <a href="{{ path('equipo') }}" class="dropdown-item">El Equipo</a>
                    <a href="{{ path('resenas') }}" class="dropdown-item">Reseñas</a>
                    <a href="{{ path('blog') }}" class="dropdown-item">Blog Retro</a>
                </div>
            </div>

            <div class="nav-item nav-link d-flex align-items-center">
                <button id="darkModeToggle" class="btn btn-sm-square btn-outline-primary rounded-circle">
                    <i class="bi bi-moon"></i>
                </button>
            </div>

            <a href="{{ path('contacto') }}" class="nav-item nav-link nav-contact bg-primary text-white px-5 ms-lg-5">Contacto <i class="bi bi-arrow-right"></i></a>
        </div>
    </div>
</nav>
{% block body %}{% endblock %}

<div class="container-fluid bg-light mt-5 py-5">
    <div class="container pt-5">
        <div class="row g-5">
            <div class="col-lg-3 col-md-6">
                <h5 class="text-uppercase border-start border-5 border-primary ps-3 mb-4">Contacto</h5>
                <p class="mb-4">Somos apasionados de Nintendo. Si tienes dudas sobre algún juego o reparación, no dudes en visitarnos.</p>
                <p class="mb-2"><i class="bi bi-geo-alt text-primary me-2"></i>Calle Videojuegos 123, Madrid, ES</p>
                <p class="mb-2"><i class="bi bi-envelope-open text-primary me-2"></i>ventas@dsclassics.com</p>
                <p class="mb-0"><i class="bi bi-telephone text-primary me-2"></i>+34 123 456 789</p>
            </div>
            <div class="col-lg-3 col-md-6">
                <h5 class="text-uppercase border-start border-5 border-primary ps-3 mb-4">Enlaces Rápidos</h5>
                <div class="d-flex flex-column justify-content-start">
                    <a class="text-body mb-2" href="{{ path('indice') }}"><i class="bi bi-arrow-right text-primary me-2"></i>Inicio</a>
                    <a class="text-body mb-2" href="{{ path('about') }}"><i class="bi bi-arrow-right text-primary me-2"></i>Nosotros</a>
                    <a class="text-body mb-2" href="{{ path('servicio') }}"><i class="bi bi-arrow-right text-primary me-2"></i>Servicios</a>
                    <a class="text-body mb-2" href="{{ path('equipo') }}"><i class="bi bi-arrow-right text-primary me-2"></i>El Equipo</a>
                    <a class="text-body mb-2" href="{{ path('blog') }}"><i class="bi bi-arrow-right text-primary me-2"></i>Blog</a>
                    <a class="text-body" href="{{ path('contacto') }}"><i class="bi bi-arrow-right text-primary me-2"></i>Contacto</a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <h5 class="text-uppercase border-start border-5 border-primary ps-3 mb-4">Categorías</h5>
                <div class="d-flex flex-column justify-content-start">
                    <a class="text-body mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>RPGs</a>
                    <a class="text-body mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Plataformas</a>
                    <a class="text-body mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Acción</a>
                    <a class="text-body mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Puzles</a>
                    <a class="text-body mb-2" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Estrategia</a>
                    <a class="text-body" href="#"><i class="bi bi-arrow-right text-primary me-2"></i>Consolas</a>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <h5 class="text-uppercase border-start border-5 border-primary ps-3 mb-4">Newsletter</h5>
                <form action="">
                    <div class="input-group">
                        <input type="text" class="form-control p-3" placeholder="Tu Email">
                        <button class="btn btn-primary">Suscribir</button>
                    </div>
                </form>
                <h6 class="text-uppercase mt-4 mb-3">Síguenos</h6>
                <div class="d-flex">
                    <a class="btn btn-outline-primary btn-square me-2" href="#"><i class="bi bi-twitter"></i></a>
                    <a class="btn btn-outline-primary btn-square me-2" href="#"><i class="bi bi-facebook"></i></a>
                    <a class="btn btn-outline-primary btn-square me-2" href="#"><i class="bi bi-linkedin"></i></a>
                    <a class="btn btn-outline-primary btn-square" href="#"><i class="bi bi-instagram"></i></a>
                </div>
            </div>
            <div class="col-12 text-center text-body">
                <a class="text-body" href="">Términos</a>
                <span class="mx-1">|</span>
                <a class="text-body" href="">Privacidad</a>
                <span class="mx-1">|</span>
                <a class="text-body" href="">Ayuda</a>
            </div>
        </div>
    </div>
</div>
<div class="container-fluid bg-dark text-white-50 py-4">
    <div class="container">
        <div class="row g-5">
            <div class="col-md-6 text-center text-md-start">
                <p class="mb-md-0">© <a class="text-white" href="#">DS Classics</a>. Todos los derechos reservados.</p>
            </div>
            <div class="col-md-6 text-center text-md-end">
                <p class="mb-0">Designed by <a class="text-white" href="https://htmlcodex.com">HTML Codex</a></p>
            </div>
        </div>
    </div>
</div>
<a href="#" class="btn btn-primary py-3 fs-4 back-to-top"><i class="bi bi-arrow-up"></i></a>

<script src="https://code.jquery.com/jquery-3.4.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="{{ asset('lib/easing/easing.min.js') }}"></script>
<script src="{{ asset('lib/waypoints/waypoints.min.js') }}"></script>
<script src="{{ asset('lib/owlcarousel/owl.carousel.min.js') }}"></script>
<script src="{{ asset('js/main.js') }}"></script>
<script src="{{ asset('js/dark-bg.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>